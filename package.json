{
  "name": "netcommander",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint static/js",
    "lint:css": "stylelint \"static/css/**/*.css\"",
    "format": "prettier --write \"static/js/**/*.js\" \"static/css/**/*.css\"",
    "format:check": "prettier --check \"static/js/**/*.js\" \"static/css/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "vitest": "^2.1.8"
  }
}
